# Public values used by the browser after Supabase is connected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No se necesita una clave secreta para el dashboard de solo lectura.

# Optional full-image reading. Disabled until provider/cost approval.
# Server-only: never prefix these with NEXT_PUBLIC_. No OIDC auto-activation.
CLOE_VISION_ENABLED=false
VISION_MODEL=
AI_GATEWAY_API_KEY=
# Comma-separated Supabase user IDs explicitly allowed in the pilot.
CLOE_VISION_USER_IDS=
